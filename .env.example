# Copiar a .env (ignorado por git) y completar con los valores reales.
# Dashboard de Supabase → tu proyecto → Settings → API.

SUPABASE_URL=https://TU-PROYECTO.supabase.co

# "anon public" / "publishable" — ver docs/context/8-base-de-datos-hibrida.md
# ("Seguridad de la nube"): con RLS activada (db/rls_cloud.sql) esta key no
# puede leer ni escribir nada. Queda reservada para un futuro uso de solo
# lectura desde la app.
SUPABASE_KEY=tu-anon-public-key

# "service_role" (secret) — bypassea RLS. La usa el sync (src/db/sync.py),
# NUNCA debe ir en código que corra en el navegador ni compartirse fuera
# de este archivo local.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
