# Copiar a .env (ignorado por git) y completar con los valores reales.
# Dashboard de Supabase → tu proyecto → Settings → API.

SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave SECRETA (Settings → API Keys → secret, sb_secret_…): la usa el sync.
# Solo en la máquina que sincroniza. Con RLS activada es la única con acceso.
SUPABASE_SECRET_KEY=
# Clave pública (publishable/anon): ya no tiene acceso; solo la usa
# scripts/verificar_rls.py para comprobarlo.
SUPABASE_KEY=tu-publishable-key

# Detección (solo para procesar videos nuevos con src/detection/run_inference.py;
# el dashboard no la usa). run_inference la lee del entorno: export ROBOFLOW_API_KEY=...
# ROBOFLOW_API_KEY=

# Carpeta de los respaldos automáticos y de scripts/respaldo.py
# (por defecto data/respaldos/; conviene otro disco o un pendrive).
# ANALIZADOR_DIR_RESPALDOS=
